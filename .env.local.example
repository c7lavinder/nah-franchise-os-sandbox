# ==============================================
# NAH Franchise OS — Environment Variables
# ==============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ═══════════════════════════════════════════════
# REQUIRED FOR LOCAL DEV
# ═══════════════════════════════════════════════

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Anthropic (Claude — powers Scout) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- GoHighLevel (CRM) ---
GHL_API_KEY=your-ghl-pit-key
GHL_CLIENT_ID=your-ghl-client-id
GHL_CLIENT_SECRET=your-ghl-client-secret
GHL_LOCATION_ID=your-ghl-location-id

# --- App Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=/frandev
MASTERSUITE_API_JWT_SECRET=your-local-jwt-secret

# ═══════════════════════════════════════════════
# REQUIRED FOR PRODUCTION (set in Vercel)
# ═══════════════════════════════════════════════

# --- Cron Auth (Vercel Cron passes as Authorization: Bearer header) ---
CRON_SECRET=your-cron-secret-here

# --- MasterSuite DB sync (required for production-like builds and cron testing) ---
MASTERSUITE_DB_HOST=your-db-host
MASTERSUITE_DB_PORT=3306
MASTERSUITE_DB_USER=your-db-user
MASTERSUITE_DB_PASSWORD=your-db-password
MASTERSUITE_DB_NAME=your-db-name
MASTERSUITE_API_URL=http://mastersuite-api

# --- Webhook Auth (shared secret for inbound webhooks) ---
# DEFERRED: do not set until each webhook provider is configured with the same value
# WEBHOOK_SHARED_SECRET=your-webhook-shared-secret-here

# ═══════════════════════════════════════════════
# OPTIONAL FEATURES
# ═══════════════════════════════════════════════

# --- OpenAI (Whisper voice transcription) ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- GHL optional config ---
GHL_DEFAULT_CALENDAR_ID=your-default-calendar-id
GHL_SENDING_EMAIL=chad@newagainhouses.com

# --- Scout model override (defaults to claude-haiku-4-5-20251001) ---
# SCOUT_MODEL=claude-haiku-4-5-20251001
# NEXT_PUBLIC_SCOUT_MODEL=claude-haiku-4-5-20251001

# --- Read.ai webhook signing keys (per-user, uppercased email prefix) ---
# READ_AI_WEBHOOK_SIGNING_KEY_MATT=your-signing-key
# READ_AI_WEBHOOK_SIGNING_KEY_CHAD=your-signing-key
