# ==============================================
# NAH Franchise OS — Environment Variables
# ==============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Anthropic (Claude — powers Scout) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- GoHighLevel (CRM) ---
GHL_API_KEY=your-ghl-api-key
GHL_CLIENT_ID=your-ghl-client-id
GHL_CLIENT_SECRET=your-ghl-client-secret
GHL_LOCATION_ID=your-ghl-location-id

# --- OpenAI (Whisper voice transcription) ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- Cron Auth (Vercel Cron passes this as Authorization: Bearer header) ---
CRON_SECRET=your-cron-secret-here

# --- Webhook Auth (shared secret for inbound webhooks — GHL, Docusign, etc.) ---
WEBHOOK_SHARED_SECRET=your-webhook-shared-secret-here

# --- App Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
