{
  "rewrites": [
    {
      "source": "/api/webhooks/:path*",
      "destination": "/frandev/api/webhooks/:path*"
    }
  ],
  "crons": [
    {
      "path": "/frandev/api/cron/journals",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/frandev/api/cron/weekly-report",
      "schedule": "0 23 * * 0"
    },
    {
